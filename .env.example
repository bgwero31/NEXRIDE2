# NEXRIDE Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key_here

# Optional: your Render notification endpoint that sends OneSignal pushes.
# The app still queues events in Firebase if this is empty.
NEXT_PUBLIC_NEXRIDE_NOTIFY_ENDPOINT=https://your-render-service.onrender.com/nexride/notify

# Server-side only for your Render notifier, not for the browser app:
# ONESIGNAL_APP_ID=your_onesignal_app_id
# ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key
