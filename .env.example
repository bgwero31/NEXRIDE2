# NEXRIDE Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_browser_key_here

# Public OneSignal App ID used by the Android app.
NEXT_PUBLIC_ONESIGNAL_APP_ID=

# Optional: your Render notification endpoint that sends OneSignal pushes.
# The app still queues events in Firebase if this is empty.
NEXT_PUBLIC_NEXRIDE_NOTIFY_ENDPOINT=

# Server-side only for your Render notifier, not for the browser app:
# ONESIGNAL_APP_ID=your_onesignal_app_id
# ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key

# IMGBB profile/avatar uploads
NEXT_PUBLIC_IMGBB_API_KEY=30df4aa05f1af3b3b58ee8a74639e5cf

# Server-only settings for the built-in NEXRIDE ride-alert relay.
# ONESIGNAL_APP_ID must match NEXT_PUBLIC_ONESIGNAL_APP_ID.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
NEXRIDE_FIREBASE_DATABASE_URL=
NEXRIDE_FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional comma-separated Firebase owner UIDs. Firebase admin custom claims also grant access.
NEXRIDE_ADMIN_UIDS=
